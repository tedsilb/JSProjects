{
	"compilerOptions": {
		"lib": ["DOM", "ES2022"],
		"sourceMap": false,
		"strict": true,
		"moduleResolution": "bundler",
		"target": "ES2022",
		"jsx": "preserve",
		"preserveConstEnums": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"module": "ESNext"
	},
	"include": ["projects/**/*.ts"],
	"exclude": ["node_modules", "dist", ".cache"]
}
